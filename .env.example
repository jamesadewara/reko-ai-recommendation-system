APP_NAME="reko-ai-recommendation-system"
DEBUG=True # When debug is true logging is set to DEBUG level, otherwise INFO level

# ── Database (MongoDB async via Beanie and Pymongo) ──────────────────────────
DATABASE_URL=mongodb://localhost:27017/reko_ai_system_db
DATABASE_NAME=reko_ai_system_db

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600  # 1 hour
DB_POOL_PRE_PING=True
DB_CONNECT_TIMEOUT=60 # 1 minute for self-healing

RABBITMQ_URL="amqp://guest:guest@localhost:5672/"

# ── Service Mesh URLs ────────────────────────────────────────────────────────
REKO_AI_AUTH_URL="http://localhost:8000"
REKO_AI_SYSTEM_URL="http://localhost:8001"
REKO_AI_FRONTEND_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://localhost:8001"

# ── Auth — RS256 JWT Verification (Hybrid: Local Key + JWKS Fallback) ────────
# JWKS_URL: endpoint on reko-ai-auth-system to fetch public keys
JWKS_URL=http://localhost:8000/api/v1/.well-known/jwks.json
JWT_ALGORITHM=RS256

# JWT_PUBLIC_KEY (RS2A): The RSA Public Key in PEM format (escaped)
# If empty, the system looks at app/certs/public.pem
JWT_PUBLIC_KEY=""
JWT_PUBLIC_KEY_PATH="app/certs/public.pem"

# INTERNAL_SERVICE_SECRET: Shared secret for service-to-service calls
INTERNAL_SERVICE_SECRET="your-internal-service-secret-key"